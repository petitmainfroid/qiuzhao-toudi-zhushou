{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qiuzhao.local/schemas/ats-corpus-sample-v1.schema.json",
  "title": "Privacy-safe ATS corpus sample",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpusSchemaVersion", "observation", "annotations"],
  "properties": {
    "corpusSchemaVersion": { "const": 1 },
    "observation": { "$ref": "#/$defs/observation" },
    "annotations": { "$ref": "#/$defs/annotations" }
  },
  "$defs": {
    "boundedText100": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "nullableBoundedText80": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 80 }
      ]
    },
    "familyId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,47}$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "capturedAt", "source", "family", "sections", "controls", "summary", "privacy"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "capturedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
        },
        "source": { "$ref": "#/$defs/source" },
        "family": { "$ref": "#/$defs/family" },
        "sections": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "controls": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/control" }
        },
        "summary": { "$ref": "#/$defs/summary" },
        "privacy": { "$ref": "#/$defs/privacy" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "pathTemplate", "language", "pageType", "captureToolVersion"],
      "properties": {
        "origin": { "type": "string", "minLength": 9, "maxLength": 255, "pattern": "^https://" },
        "pathTemplate": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^/[^?#]*$" },
        "language": {
          "type": "string",
          "pattern": "^(?:und|[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8}){0,2})$"
        },
        "pageType": {
          "enum": ["application", "profile", "screening", "assessment", "unknown"]
        },
        "captureToolVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "confidence", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/familyId" },
        "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": { "enum": ["origin", "path", "control-structure", "semantic-marker"] },
        "detail": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlKey", "role", "tag", "semantics", "disabled", "readOnly", "required", "multiple", "boundary", "safety"],
      "properties": {
        "controlKey": { "type": "string", "pattern": "^control_[0-9]{4}$" },
        "role": { "enum": ["textbox", "combobox", "listbox", "option", "checkbox", "radio", "switch", "button", "link"] },
        "tag": { "enum": ["input", "textarea", "select", "button", "a", "contenteditable", "custom"] },
        "inputType": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "semantics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": { "$ref": "#/$defs/boundedText100" },
            "ariaLabel": { "$ref": "#/$defs/boundedText100" },
            "placeholder": { "$ref": "#/$defs/boundedText100" },
            "name": { "$ref": "#/$defs/boundedText100" },
            "nearbyText": { "$ref": "#/$defs/boundedText100" },
            "section": { "$ref": "#/$defs/boundedText100" }
          }
        },
        "options": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "disabled": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "required": { "type": "boolean" },
        "multiple": { "type": "boolean" },
        "boundary": { "enum": ["main", "same-origin-frame", "open-shadow"] },
        "safety": { "enum": ["ordinary", "credential", "verification", "identity", "final-submit", "file"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlCount", "blockedControlCount", "frameControlCount", "openShadowControlCount", "sectionCount"],
      "properties": {
        "controlCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "blockedControlCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "frameControlCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "openShadowControlCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "sectionCount": { "type": "integer", "minimum": 0, "maximum": 50 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentValuesIncluded", "sessionReferencesIncluded", "queryValuesIncluded", "fileMetadataIncluded"],
      "properties": {
        "currentValuesIncluded": { "const": false },
        "sessionReferencesIncluded": { "const": false },
        "queryValuesIncluded": { "const": false },
        "fileMetadataIncluded": { "const": false }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewStatus", "reviewedAt", "reviewedFamilyId", "controls"],
      "properties": {
        "reviewStatus": { "enum": ["unreviewed", "reviewed"] },
        "reviewedAt": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
            }
          ]
        },
        "reviewedFamilyId": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/familyId" }
          ]
        },
        "controls": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/controlAnnotation" }
        }
      }
    },
    "controlAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlKey", "canonicalField", "section", "behaviors", "expectedAction", "expectedDriver", "expectedVerification", "notes"],
      "properties": {
        "controlKey": { "type": "string", "pattern": "^control_[0-9]{4}$" },
        "canonicalField": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z][A-Za-z0-9]*(?:(?:\\[\\])?\\.[A-Za-z][A-Za-z0-9]*|\\[\\])*$" }
          ]
        },
        "section": { "$ref": "#/$defs/nullableBoundedText80" },
        "behaviors": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "native-input",
              "native-select",
              "contenteditable",
              "custom-select",
              "popup-picker",
              "date-input",
              "date-picker",
              "date-range",
              "multi-select",
              "repeatable-record",
              "async-options",
              "rerender-after-write",
              "validation-on-blur",
              "same-origin-frame",
              "open-shadow",
              "file-gate",
              "unknown"
            ]
          }
        },
        "expectedAction": { "enum": ["fill", "confirm", "exclude", "manual", "unknown"] },
        "expectedDriver": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,47}$" }
          ]
        },
        "expectedVerification": { "enum": ["normalized-equality", "selected-option", "checked-state", "attachment-gate", "none"] },
        "notes": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 160 }
          ]
        }
      }
    }
  }
}
