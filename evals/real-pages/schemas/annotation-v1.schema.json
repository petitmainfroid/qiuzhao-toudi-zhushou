{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.qiuzhao.invalid/evals/real-pages/annotation-v1.schema.json",
  "title": "Frozen real-page annotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "annotationId", "revision", "siteId", "page", "createdAt", "annotator", "provenance", "runtimeDenominatorSource", "fields", "reviewedByUserAt", "annotationHash", "frozen"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "real-page-annotation" },
    "annotationId": { "type": "string", "pattern": "^ann_[A-Za-z0-9_-]{6,80}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "siteId": { "$ref": "#/$defs/siteId" },
    "page": { "$ref": "#/$defs/page" },
    "createdAt": { "type": "string", "format": "date-time" },
    "annotator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "agentScanViewed"],
      "properties": {
        "role": { "const": "independent-human-annotator" },
        "agentScanViewed": { "const": false }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactRef", "evidenceClass"],
        "properties": {
          "artifactRef": { "type": "string", "pattern": "^(ats-corpus/(ground-truth|observations)|artifacts)/[A-Za-z0-9_./-]+$" },
          "evidenceClass": { "enum": ["primitive-regression", "public-contract-drift", "historical-structural-observation"] }
        }
      }
    },
    "runtimeDenominatorSource": { "const": "reachable-field-instances" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/field" }
    },
    "reviewedByUserAt": { "type": "string", "format": "date-time" },
    "annotationHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "frozen": { "const": true }
  },
  "$defs": {
    "siteId": { "enum": ["xiaomi-feishu", "metaapp-feishu", "nio-feishu", "anker-feishu", "hesai-feishu", "huya-moka", "lenovo-talent", "ctrip-careers"] },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "normalizedPath"],
      "properties": {
        "origin": { "type": "string", "pattern": "^https://[a-z0-9.-]+$" },
        "normalizedPath": { "type": "string", "pattern": "^/" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldInstanceId", "semanticKey", "stepId", "conditionRef", "repeatable", "controlKind", "required", "safetyClass"],
      "properties": {
        "fieldInstanceId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,119}$" },
        "semanticKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.\\[\\]-]{1,119}$" },
        "stepId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,79}$" },
        "conditionRef": { "type": ["string", "null"] },
        "repeatable": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["groupRef", "instanceIndex"],
              "properties": {
                "groupRef": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,79}$" },
                "instanceIndex": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        },
        "controlKind": { "enum": ["text", "textarea", "contenteditable", "native-select", "custom-select", "radio", "checkbox", "date", "month", "date-range", "attachment", "verification", "identity", "action", "unknown"] },
        "required": { "type": "boolean" },
        "safetyClass": { "enum": ["ordinary", "sensitive-confirmation", "attachment-confirmation", "manual-verification", "consent", "destructive", "final-submit", "site-policy", "inaccessible"] }
      }
    }
  }
}
